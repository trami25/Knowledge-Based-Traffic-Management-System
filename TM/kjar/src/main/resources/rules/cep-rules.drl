package rules;

import com.ftn.sbnz.model.models.*;
import java.util.Set;
import java.util.HashSet;

// Declare event types for CEP
declare TrafficDensity
    @role(event)
    @timestamp(timestamp)
end

declare Accident
    @role(event)
    @timestamp(timestamp)
end

declare PublicTransportDelay
    @role(event)
    @timestamp(timestamp)
end

declare Weather
    @role(event)
    @timestamp(timestamp)
end

declare PedestrianDetected
    @role(event)
    @timestamp(timestamp)
end

declare EmergencyVehicle
    @role(event)
end

declare Vehicle
    @role(event)
end

// Replace countDistinct with a custom accumulate function
rule "Complex Traffic Crisis Detection"
when
    // Basic traffic density tracking over 15-minute window
    $avgDensity : Number(doubleValue > 70) from accumulate(
        TrafficDensity($c : crossroad, $value : value) over window:time(15m) and
        exists Crossroad(id == $c),
        average($value)
    )
    
    // Count critical events in time windows
    $accidentCount : Number() from accumulate(
        Accident($c : crossroad) over window:time(20m) and
        exists Crossroad(id == $c),
        count(1)
    )
    
    $pedestrianCount : Number() from accumulate(
        PedestrianDetected($c : crossroad) over window:time(10m) and
        exists Crossroad(id == $c),
        count(1)
    )
    
    $busDelayCount : Number() from accumulate(
        PublicTransportDelay(delayMinutes > 10) over window:time(20m),
        count(1)
    )
    
    $weatherCount : Number() from accumulate(
        Weather(intensity == "high" || intensity == "heavy") over window:time(30m),
        count(1)
    )
    
    // Calculate crisis severity score
    eval(($accidentCount.intValue() * 3) + 
         ($pedestrianCount.intValue() * 1) + 
         ($busDelayCount.intValue() * 2) + 
         ($weatherCount.intValue() * 2) >= 5)
then
    int crisisScore = ($accidentCount.intValue() * 3) + 
                     ($pedestrianCount.intValue() * 1) + 
                     ($busDelayCount.intValue() * 2) + 
                     ($weatherCount.intValue() * 2);
    
    String severity = crisisScore >= 10 ? "CRITICAL" : 
                     (crisisScore >= 7 ? "HIGH" : "MODERATE");
    
    // Escalate response based on severity
    if (crisisScore >= 10) {
        insert(new TrafficAction("SYSTEM", "activateEmergencyProtocol", 120));
        insert(new TrafficAction("SYSTEM", "blockNonEssentialTraffic", 60));
        insert(new Notification("CRITICAL traffic crisis detected - Emergency protocol activated"));
    } else if (crisisScore >= 7) {
        insert(new TrafficAction("SYSTEM", "activateRerouting", 90));
        insert(new TrafficAction("SYSTEM", "extendAllGreenLights", 30));
        insert(new Notification("HIGH traffic crisis detected - Rerouting activated"));
    } else {
        insert(new TrafficAction("SYSTEM", "adaptiveSignaling", 45));
        insert(new Notification("MODERATE traffic crisis detected - Adaptive signaling enabled"));
    }
end

rule "Temporal Traffic Pattern Analysis"
when
    // Traffic trend analysis over multiple time windows
    $currentAvg : Number(doubleValue > 60) from accumulate(
        TrafficDensity($c : crossroad, $value : value) over window:time(5m) and
        exists Crossroad(id == $c),
        average($value)
    )
    
    $previousAvg : Number() from accumulate(
        TrafficDensity($c : crossroad, $value : value) over window:time(5m, 10m) and
        exists Crossroad(id == $c),
        average($value)
    )
    
    // Correlation with mass events
    $eventDay : EventDay(expectedTraffic > 500)
    
    // Count affected crossroads using a workaround for countDistinct
    $affectedCrossroadsSet : Set() from accumulate(
        TrafficDensity($c : crossroad, value > 75) over window:time(15m) and
        exists Crossroad(id == $c),
        collectSet($c)
    )
    
    // Check if we have multiple affected crossroads
    eval($affectedCrossroadsSet.size() >= 3)
    
    // Calculate trend direction and magnitude
    eval($currentAvg.doubleValue() - $previousAvg.doubleValue() > 15 || 
         $affectedCrossroadsSet.size() >= 4)
then
    double trendChange = $currentAvg.doubleValue() - $previousAvg.doubleValue();
    boolean isWorsening = trendChange > 15;
    boolean isSystemWide = $affectedCrossroadsSet.size() >= 4;
    
    String pattern;
    String action;
    int duration;
    
    if (isSystemWide && isWorsening) {
        pattern = "SYSTEM-WIDE CONGESTION SPREADING";
        action = "activateRegionalRerouting";
        duration = 180;
    } else if (isSystemWide) {
        pattern = "MULTI-CROSSROAD SATURATION";
        action = "coordinatedSignaling";
        duration = 120;
    } else if (isWorsening) {
        pattern = "RAPID CONGESTION BUILDUP";
        action = "preemptiveGreenExtension";
        duration = 60;
    } else {
        pattern = "MASS EVENT TRAFFIC DISTRIBUTION";
        action = "eventTrafficManagement";
        duration = $eventDay.getExpectedTraffic() > 2000 ? 240 : 120;
    }
    
    insert(new TrafficAction("SYSTEM", action, duration));
    insert(new Notification("Pattern detected: " + pattern + " - Action: " + action));
end

